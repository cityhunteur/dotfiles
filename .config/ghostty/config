# Follow the desktop appearance using the Signal variants of Nord Light and Nord.
theme = light:signal-light,dark:signal-dark
# Keep input readable when a running TUI retains its previous background.
minimum-contrast = 4.5
title = ""
macos-titlebar-style = hidden
confirm-close-surface = false
window-save-state = always
window-padding-x = 12
window-padding-y = 2,0
window-padding-balance = equal
unfocused-split-opacity = 0.65

font-family = ""
font-family = "PragmataPro Mono Liga"
font-size = 16
# Synthesize bold/italic because only PragmataProMonoLiga-Regular.ttf is installed.
font-synthetic-style = bold,italic,bold-italic
font-thicken = true
font-feature = "calt"
font-feature = "lima"
font-feature = "dig"
font-feature = "ss20"
adjust-cell-height = 40%

# Thicker bar cursor (pixels added to the font's default thickness)
adjust-cursor-thickness = 3

# One steady bar everywhere (prompt, running commands, after tmux resets it).
# Ghostty's shell integration still switches to a block in vi normal mode;
# blink=false makes it export cursor:steady to the shell.
cursor-style = bar
cursor-style-blink = false
# Cursor and selection colours come from the theme copies.

quick-terminal-position = right

keybind = ctrl+`=toggle_quick_terminal
keybind = shift+enter=text:\x1b\r

copy-on-select = clipboard
right-click-action = paste
