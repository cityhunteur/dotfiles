# signal-light: the installed Ghostty "Nord Light" theme with Meister / Continuum
# Signal 3.0.0 light cursor and selection roles merged in.
# Based on Ghostty 1.4.0 Nord Light. Slots 1–6 use stronger hues so file
# types stay distinct on the light canvas under Ghostty's contrast setting.
# Signal cursor roles and independent Nord selection references derive from the skills canonical tokens.

palette = 0=#3b4252
palette = 1=#ae2547
palette = 2=#19613b
palette = 3=#854900
palette = 4=#1653a6
palette = 5=#77349b
palette = 6=#00626b
palette = 7=#a5abb6
palette = 8=#4c566a
palette = 9=#bf616a
palette = 10=#96b17f
palette = 11=#c5a565
palette = 12=#81a1c1
palette = 13=#b48ead
palette = 14=#82afae
palette = 15=#eceff4
background = #eceff4
foreground = #414858
# Keep dim command output legible on the Snow Storm canvas.
faint-opacity = 0.9

# Signal cursor uses contrasting black/white; native selection keeps its paired roles.
cursor-color = #171717
cursor-text = #ffffff
selection-background = #AEBED1
selection-foreground = #2E3440
